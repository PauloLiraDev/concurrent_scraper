#!/bin/bash
# filepath: /home/paulo-lira/Projects/concurrent_scraper/pre-push

echo "⚙️ Running pre-push tests for Concurrent Scraper..."

# Salvar o diretório atual
CURRENT_DIR=$(pwd)

# Verificar se o container Docker está em execução
if docker compose ps | grep selenium-fastapi | grep Up > /dev/null; then
  echo "🐳 Container is running, executing tests inside container..."
  docker compose exec -T api python -m src.run_tests
  EXIT_CODE=$?
else
  echo "🔍 Container is not running, executing tests locally..."
  
  # Navegar para a pasta src
  cd src || { echo "❌ Failed to navigate to src directory"; exit 1; }
  
  # Executar os testes
  python run_tests.py
  EXIT_CODE=$?
  
  # Voltar ao diretório original
  cd "$CURRENT_DIR" || { echo "❌ Failed to return to original directory"; exit 1; }
fi

# Verificar o resultado dos testes
if [ $EXIT_CODE -ne 0 ]; then
  echo "❌ Tests failed! Git push aborted."
  echo "🔧 Please fix the issues before trying to push again."
  exit 1
else
  echo "✅ All tests passed successfully!"
  echo "🚀 Continuing with git push..."
  exit 0
fi